{
  "name": "interno-rotas",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/apply-csp-origin.mjs && node scripts/verify-dist-assets.mjs",
    "build:hml": "tsc -b && vite build --mode hml && node scripts/apply-csp-origin.mjs --hml && node scripts/apply-hml-noindex.mjs --hml && node scripts/verify-hml-artifact.mjs && node scripts/verify-dist-assets.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && gh-pages -d dist",
    "quality": "pnpm lint && pnpm build",
    "format": "biome format --write ./src",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "test": "vitest run",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:og": "node scripts/generate-og-image.mjs",
    "encode-data": "node scripts/encode-data.mjs",
    "encode-data:verify": "node scripts/encode-data.mjs --decode",
    "env:pull": "node scripts/load-env.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.4.0",
    "@fontsource/poppins": "^5.2.7",
    "@sentry/react": "10.51.0",
    "@tanstack/react-query": "5.100.9",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "i18next": "26.0.10",
    "lucide-react": "1.8.0",
    "maplibre-gl": "5.24.0",
    "protobufjs": "8.7.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-ga4": "3.0.1",
    "react-i18next": "17.0.7",
    "react-map-gl": "8.1.1",
    "react-router-dom": "7.18.2",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "use-debounce": "10.1.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@ladle/react": "5.1.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/react": "16.3.2",
    "@types/geojson": "7946.0.16",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.4",
    "autoprefixer": "10.5.0",
    "gh-pages": "6.3.0",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "postcss": "8.5.10",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "vite": "8.0.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.4",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
