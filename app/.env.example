# Template de desenvolvimento — copie para .env.development e preencha se necessário.
# NUNCA commite o .env.development — ele está no .gitignore.
#
# Produção: pnpm env:pull  →  baixa .env.production do Bitwarden

VITE_API_URL=http://localhost:43111
VITE_SENTRY_DSN=
# VITE_VAPID_PUBLIC_KEY= (opcional em dev, obrigatório em prod para Web Push)
# VITE_TENANT_SLUG= (opcional, default definido em src/tenants/tenantDefinitions.ts)
# VITE_GA_MEASUREMENT_ID= (opcional, desabilita analytics quando ausente)
# VITE_TURNSTILE_SITE_KEY= (opcional em dev, obrigatório em prod para Turnstile)
